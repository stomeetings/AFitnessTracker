# Copy this file to backend/.env and fill it in. backend/.env is git-ignored: never commit a real key.
GROQ_API_KEY=

# Which microphone to use. Without this the Windows default input is used, which can be a silent virtual device
# (DroidCam Audio). A device number, or any part of its name (case, spaces and punctuation are ignored), or several
# choices separated by commas, tried in order (a headset that is unplugged falls through to the next). List the
# devices with:   backend/.venv/Scripts/python backend/scripts/stt_smoke.py --devices
# STT_INPUT_DEVICE=KORP THALLIUM
# STT_INPUT_DEVICE=KORP THALLIUM, Realtek
# STT_INPUT_DEVICE=3

# Optional: speech-detection threshold (microphone RMS, 0..1; default 0.008). Lower it if quiet words such as a soft
# "help" are not picked up; raise it if room noise is being sent. stt_smoke.py prints the level it measured.
# VOICE_MIN_RMS=0.008

# Optional: seconds of silence that end an utterance (default 0.4). Lower = a one-word answer is sent sooner, but
# slow speech is cut at its pauses more often (the pieces are joined again, up to 4 s apart).
# VOICE_TRAIL_S=0.4

# Optional: how long a sound must be to count as speech (default 0.06 s = 3 frames of 20 ms). Lower it if a quick
# "help" or "OK" shows up as "too short to count as speech" in stt_smoke.py; raise it if clicks and taps are sent.
# VOICE_MIN_ON_S=0.06

# Optional: how tone-like a sound must be (0..1; default 0.65) to be ignored as a beep instead of speech.
# VOICE_TONE_SHARE=0.65
