# Copy this file to backend/.env and fill it in. backend/.env is git-ignored: never commit a real key.
GROQ_API_KEY=

# Which microphone to use. Without this the Windows default input is used, which can be a silent virtual device
# (DroidCam Audio). A device number, or any part of its name (case, spaces and punctuation are ignored), or several
# choices separated by commas, tried in order (a headset that is unplugged falls through to the next). List the
# devices with:   backend/.venv/Scripts/python backend/scripts/stt_smoke.py --devices
# STT_INPUT_DEVICE=KORP THALLIUM
# STT_INPUT_DEVICE=KORP THALLIUM, Realtek
# STT_INPUT_DEVICE=3

# Optional: speech-detection threshold (microphone RMS, 0..1; default 0.008). Lower it if quiet words such as a soft
# "help" are not picked up; raise it if room noise is being sent. stt_smoke.py prints the level it measured.
# VOICE_MIN_RMS=0.008

# Optional: seconds of silence that end an utterance (default 0.4). Lower = a one-word answer is sent sooner, but
# slow speech is cut at its pauses more often (the pieces are joined again, up to 4 s apart).
# VOICE_TRAIL_S=0.4

# Optional: how long a sound must be to count as speech (default 0.06 s = 3 frames of 20 ms). Lower it if a quick
# "help" or "OK" shows up as "too short to count as speech" in stt_smoke.py; raise it if clicks and taps are sent.
# VOICE_MIN_ON_S=0.06

# Pose model speed. YOLO runs in FP16 on the GPU by default (set 0 to force full precision). The network input size defaults
# to 640; phone frames arrive at most 480 px on the long side, so 480 is faster with little loss (a multiple of 32).
# YOLO_HALF=1
# YOLO_IMGSZ=480

# Remote (mobile browser) sessions over /ws/session ("This device" in the page). OFF by default.
# REMOTE_SESSIONS=1
# Strongly recommended whenever the server is reachable through a tunnel (cloudflared, ngrok): the phone must send
# this secret before a session starts. Use a long random value, e.g.
#   backend/.venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(16))"
# On the phone open https://<tunnel-name>/?token=<value> once (it is saved and removed from the address bar), or type it
# on the connect screen. With REMOTE_SESSIONS on and no token the server logs a warning at startup.
# REMOTE_ACCESS_TOKEN=
# Simultaneous remote sessions (default 4).
# REMOTE_MAX_SESSIONS=4
# A browser may only open a session from this site itself. List other allowed origins here, comma separated, if you
# front the app with another address; "*" turns the check off.
# REMOTE_ALLOWED_ORIGINS=https://rehab.example.com
# Requests that arrive through a tunnel/proxy can NOT use the desktop routes (the server camera stream, camera switch,
# config, fall buttons, telemetry): only the remote session, the page itself and a few harmless reads. No setting needed.

# Optional: how tone-like a sound must be (0..1; default 0.65) to be ignored as a beep instead of speech.
# VOICE_TONE_SHARE=0.65
REMOTE_SESSIONS=1
REMOTE_ACCESS_TOKEN=-NNwdXQHGlS2Veru_FoHWA
ANGLES_3D=0
# SMOOTH_TAU_S=0
